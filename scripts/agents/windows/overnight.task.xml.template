<?xml version="1.0" encoding="UTF-16"?>
<!-- Rendered by scripts/agents/windows/install.sh (UTF-8 here, written out as UTF-16 for schtasks).
     Placeholders: __DESCRIPTION__ __START__ __LIMIT__ __PS1__ __DISTRO__ __LAUNCHER__ __WINLOG__.
     WakeToRun wakes the PC for the run; LogonType Password runs it whether or not the owner is logged
     on (schtasks /ru /rp supplies the account). StartWhenAvailable is off: a slot missed while the PC
     was off is not run late (runner.startWindow guards the same thing inside the runner). -->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>__DESCRIPTION__</Description>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>__START__</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>Password</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>false</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>true</WakeToRun>
    <ExecutionTimeLimit>__LIMIT__</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "__PS1__" -Distro "__DISTRO__" -Launcher "__LAUNCHER__" -Log "__WINLOG__"</Arguments>
    </Exec>
  </Actions>
</Task>
