{
  "$comment": "Repo facts for the generic agent scripts in scripts/agents/ and the always-on workflows. Machine-specific values (key paths, log dir, schedule) come from env vars, never from this file.",
  "repo": {
    "baseBranch": "development",
    "protectedBranches": ["development", "main"],
    "branchPrefixes": ["feature/", "fix/", "chore/", "ci/"]
  },
  "jira": {
    "projectKey": "OV",
    "cloudId": "a98977c6-123f-4e4d-90f4-3f2b1084c402"
  },
  "bot": {
    "login": "overland-bot[bot]",
    "commitName": "overland-bot[bot]",
    "commitEmail": "343806393+overland-bot[bot]@users.noreply.github.com",
    "keyDir": "~/.config/overland-bot"
  },
  "labels": {
    "github": {
      "reviewRounds": ["review-round-1", "review-round-2"],
      "needsHuman": "needs-human",
      "baselineChange": "baseline-change",
      "preview": "preview",
      "prType": ["bug", "enhancement"],
      "area": ["area:frontend", "area:tooling"]
    },
    "jira": {
      "readyForBuild": "ready-for-build",
      "blocked": "blocked",
      "sizes": ["size-s", "size-m", "size-l"]
    }
  },
  "commands": {
    "install": "cd client && npm ci",
    "build": "cd client && npm run build",
    "buildOutputDir": "client/build",
    "verify": "node .claude/skills/verify-overland/scripts/verify.mjs",
    "verifySteps": ["bootstrap", "launch", "doctor", "drive", "cleanup"]
  },
  "review": {
    "maxRounds": 2
  },
  "runner": {
    "builderAgent": "builder-frontend",
    "maxTicketsPerNight": 3,
    "allowedSizes": ["size-s", "size-m"],
    "$comment": "After 2-3 clean nights: maxTicketsPerNight 5, allowedSizes add size-l.",
    "maxTurns": 150,
    "wallClockMinutes": 50,
    "maxBudgetUsd": 15,
    "pickModel": "sonnet",
    "$modelComment": "Build model per ticket: a Jira label <modelLabelPrefix><model> wins (only models listed in modelBySize values or allowedModels), else modelBySize by the ticket size label, else the agent file default.",
    "modelLabelPrefix": "model:",
    "allowedModels": ["sonnet", "opus"],
    "modelBySize": { "size-s": "sonnet", "size-m": "opus", "size-l": "opus" },
    "$claudeAiConnectorsComment": "false = headless runs load only the MCP servers from the Claude Code config (ENABLE_CLAUDEAI_MCP_SERVERS=false), not the claude.ai account connectors (Gmail, Drive, ...).",
    "claudeAiConnectors": false,
    "envFiles": ["client/.env"],
    "$disallowedToolsComment": "Denied for the headless builder; deny beats allow. Never end a rule in \":*\" (legacy prefix syntax: Bash(git push *:*) silently matches nothing useful); use \":**\". The runner also denies Bash(git push * <branch>*) for each repo.protectedBranches.",
    "disallowedTools": [
      "Bash(git push *:**)", "Bash(git push *+*)", "Bash(git push *--force*)", "Bash(git push * -f*)",
      "Bash(git push *--delete*)", "Bash(git push * -d*)", "Bash(git push *--prune*)",
      "Bash(git push *--all*)", "Bash(git push *--mirror*)",
      "Bash(gh pr ready *--undo*)", "Bash(gh pr merge*)", "Bash(gh pr review*)", "Bash(gh pr close*)", "Bash(gh api*)",
      "Bash(find *-exec*)", "Bash(find *-ok*)", "Bash(find *-delete*)"
    ],
    "$allowedToolsComment": "Headless builder allowlist (OV-82). Passed on the command line with --permission-prompts none: anything else is denied at once and logged, never prompted.",
    "allowedTools": [
      "Read", "Write", "Edit", "Glob", "Grep",
      "mcp__atlassian__getJiraIssue",
      "mcp__atlassian__searchJiraIssuesUsingJql",
      "mcp__atlassian__atlassianUserInfo",
      "mcp__atlassian__getAccessibleAtlassianResources",
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git branch*)",
      "Bash(git show*)", "Bash(git rev-parse*)", "Bash(git ls-remote*)",
      "Bash(git fetch*)", "Bash(git switch -c *)", "Bash(git checkout -b *)",
      "Bash(git add *)", "Bash(git commit *)",
      "Bash(git push -u origin feature/*)", "Bash(git push -u origin fix/*)",
      "Bash(git push origin feature/*)", "Bash(git push origin fix/*)",
      "Bash(gh pr create *)", "Bash(gh pr edit *)", "Bash(gh pr ready*)",
      "Bash(gh pr view*)", "Bash(gh pr list*)", "Bash(gh pr checks*)", "Bash(gh label list*)",
      "Bash(npm ci)", "Bash(npm run build)", "Bash(cd client && npm ci)", "Bash(cd client && npm run build)",
      "Bash(node .claude/skills/verify-overland/scripts/verify.mjs*)",
      "Bash(grep *)", "Bash(find *)", "Bash(ls*)", "Bash(pwd)"
    ]
  }
}
