{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git ls-remote*)",
      "Bash(npm ci)",
      "Bash(npm run build)",
      "Bash(node .claude/skills/verify-overland/scripts/verify.mjs*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)"
    ],
    "deny": [
      "Bash(git push origin development*)",
      "Bash(git push origin main*)",
      "Bash(git push * development*)",
      "Bash(git push * main*)",
      "Bash(git checkout development)",
      "Bash(git checkout main)",
      "Bash(git switch development)",
      "Bash(git switch main)",
      "Bash(gh pr merge*)",
      "Bash(gh pr review*)",
      "Bash(gh api -X PUT*)",
      "Bash(gh api --method PUT*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Read(./client/.env*)",
      "Read(./.env*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "mcp__atlassian__updateConfluenceContent",
      "mcp__atlassian__createConfluenceContent"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-push.sh"
          }
        ]
      }
    ]
  }
}
