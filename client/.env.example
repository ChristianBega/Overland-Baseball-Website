# Copy to client/.env and fill in real values. Never commit client/.env.
# All client vars must start with REACT_APP_ (see envPrefix in vite.config.js)
# and are read as import.meta.env.REACT_APP_* (never process.env).

# Firebase Auth
REACT_APP_API_KEY=
REACT_APP_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_PROJECT_ID=
REACT_APP_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_MESSAGING_SENDER_ID=
REACT_APP_APP_ID=

# Strapi CMS
# In local dev the URL is hardcoded to http://localhost:1337 (client/src/services/strapiServices.js);
# REACT_APP_STRAPI_URL is only used in production builds.
REACT_APP_STRAPI_URL=https://your-strapi-instance.com
REACT_APP_STRAPI_API_TOKEN=
REACT_APP_STRAPI_DRAFT_MODE=false
REACT_APP_STRAPI_AUTH_LOGIN_PORTAL=https://your-login-portal.example.com
REACT_APP_STRAPI_AUTH_LOGIN_PORTAL_DEV=http://localhost:1337

# Voice CMS
REACT_APP_VOICE_CMS_URL=https://your-voice-cms.example.com
REACT_APP_VOICE_CMS_URL_DEV=https://your-voice-cms-dev.example.com

# AWS API
REACT_APP_AWS_API_BASE_URL=https://your-api.example.com

# REACT_APP_CUSTOM_ENV is set by `npm run build:dev`; do not add it here.
