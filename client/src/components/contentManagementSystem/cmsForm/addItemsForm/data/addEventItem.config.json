    },
    "rules": {
      "required": "Spring End date and time is required *"
    }
  },
  {
    "name": "seasons.spring.playerEventContent",
    "label": "Spring Player Event Content",
    "placeholder": "Enter spring player event content here...",
    "type": "textarea",
    "showWhen": {
      "field": "eventType",
      "value": "player",
      "additionalField": "seasonSelect",
      "additionalValue": "spring"
    },
    "rules": {
      "minLength": {
        "value": 250,
        "message": "Spring Player Event Content must be at least 250 characters long"
      },
      "maxLength": {
        "value": 468,
        "message": "Spring Player Event Content cannot exceed 468 characters"
      }
    }
  },
  {
    "name": "seasons.spring.active",
    "label": "Set Spring as Active Season",
    "type": "checkbox",
    "showWhen": {
      "field": "eventType",
      "value": "player",
      "additionalField": "seasonSelect",
      "additionalValue": "spring"
    }
  },
